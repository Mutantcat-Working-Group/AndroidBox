<component type="desktop-application">
  <id>org.mutantcat.androidbox</id>

  <name>AndroidBox</name>
  <summary>Run Android apps natively alongside desktop programs</summary>
  <summary xml:lang="ru">Запуск Android-приложений рядом с обычными программами</summary>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-only</project_license>
  <developer_name>Mutantcat</developer_name>

  <url type="homepage">https://github.com/Mutantcat-Working-Group/AndroidBox</url>
  <url type="bugtracker">https://github.com/Mutantcat-Working-Group/AndroidBox/issues</url>
  <url type="faq">https://docs.waydro.id/faq</url>

  <supports>
    <control>pointing</control>
    <control>keyboard</control>
    <control>touch</control>
    <control>tablet</control>
  </supports>

  <description>
    <p>
      AndroidBox is a container-based approach to boot a full Android system on a regular GNU/Linux system. The Android system inside the container has direct access to needed hardware through LXC and the binder interface.
    </p>
    <p xml:lang="ru">AndroidBox запускает полноценную систему Android в контейнере поверх обычной системы GNU/Linux. Android внутри контейнера получает прямой доступ к нужному оборудованию через LXC и интерфейс binder.</p>
  </description>

  <launchable type="desktop-id">org.mutantcat.androidbox.desktop</launchable>
  <screenshots>
    <screenshot type="default">
      <image>https://waydro.id/assets/images/hero/main_landing.jpeg</image>
    </screenshot>
    <screenshot>
      <image>https://waydro.id/assets/images/hero/clean_desktop.jpeg</image>
    </screenshot>
  </screenshots>

  <!-- Update to latest release information -->
