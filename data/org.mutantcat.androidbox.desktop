[Desktop Entry]
Type=Application
Name=AndroidBox
GenericName=Android Container
GenericName[ru]=Контейнер с Android
Exec=androidbox
Comment=Run Android apps in a containerized environment.
Comment[ru]=Запуск Android-приложений в изолированном контейнере.
Icon=org.mutantcat.androidbox
Categories=X-AndroidBox-App;Utility;
Actions=stop;initialize;
X-Purism-FormFactor=Workstation;Mobile;

[Desktop Action stop]
Name=Stop AndroidBox
Name[ru]=Остановить AndroidBox
Exec=androidbox session stop
Icon=org.mutantcat.androidbox

[Desktop Action initialize]
Name=Initialize AndroidBox
Name[ru]=Инициализировать AndroidBox
Exec=androidbox init --client
